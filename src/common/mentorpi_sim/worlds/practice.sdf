<?xml version="1.0"?>
<sdf version="1.8">
<world name="practice">
 
    <physics name="1ms" type="ignored">
<max_step_size>0.001</max_step_size>
<real_time_factor>1.0</real_time_factor>
</physics>
 
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
<plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
<plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
<plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
<render_engine>ogre2</render_engine>
</plugin>
 
    <light type="directional" name="sun">
<cast_shadows>true</cast_shadows>
<pose>0 0 10 0 0 0</pose>
<diffuse>0.8 0.8 0.8 1</diffuse>
<specular>0.2 0.2 0.2 1</specular>
<direction>-0.5 0.1 -0.9</direction>
</light>
 
    <!-- 床 -->
<model name="ground_plane">
<static>true</static>
<link name="link">
<collision name="collision">
<geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
</collision>
<visual name="visual">
<geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
<material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
</visual>
</link>
</model>
 
    <!-- 5m×5mの壁 -->
<model name="walls">
<static>true</static>
<link name="north">
<pose>0 2.5 0.15 0 0 0</pose>
<collision name="c"><geometry><box><size>5 0.05 0.3</size></box></geometry></collision>
<visual name="v"><geometry><box><size>5 0.05 0.3</size></box></geometry></visual>
</link>
<link name="south">
<pose>0 -2.5 0.15 0 0 0</pose>
<collision name="c"><geometry><box><size>5 0.05 0.3</size></box></geometry></collision>
<visual name="v"><geometry><box><size>5 0.05 0.3</size></box></geometry></visual>
</link>
<link name="east">
<pose>2.5 0 0.15 0 0 0</pose>
<collision name="c"><geometry><box><size>0.05 5 0.3</size></box></geometry></collision>
<visual name="v"><geometry><box><size>0.05 5 0.3</size></box></geometry></visual>
</link>
<link name="west">
<pose>-2.5 0 0.15 0 0 0</pose>
<collision name="c"><geometry><box><size>0.05 5 0.3</size></box></geometry></collision>
<visual name="v"><geometry><box><size>0.05 5 0.3</size></box></geometry></visual>
</link>
</model>
 
    <!-- 障害物（オレンジの箱） -->
<model name="obstacle">
<static>true</static>
<pose>-1.2 -1.2 0.15 0 0 0</pose>
<link name="link">
<collision name="c"><geometry><box><size>0.3 0.3 0.3</size></box></geometry></collision>
<visual name="v">
<geometry><box><size>0.3 0.3 0.3</size></box></geometry>
<material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material>
</visual>
</link>
</model>
 
    <!-- 仮のロボット（車輪2つ＋キャスター＋LiDAR） -->
<model name="mentorpi">
<pose>0 0 0.01 0 0 0</pose>
 
<link name="chassis">
<pose>0 0 0.06 0 0 0</pose>
<inertial>
<mass>1.5</mass>
<inertia>
<ixx>0.00365</ixx><iyy>0.00765</iyy><izz>0.0104</izz>
<ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
</inertia>
</inertial>
<collision name="collision">
<geometry><box><size>0.24 0.16 0.06</size></box></geometry>
</collision>
<visual name="visual">
<geometry><box><size>0.24 0.16 0.06</size></box></geometry>
<material><ambient>0.1 0.3 0.8 1</ambient><diffuse>0.1 0.3 0.8 1</diffuse></material>
</visual>
<collision name="caster_collision">
<pose>0.08 0 -0.045 0 0 0</pose>
<geometry><sphere><radius>0.015</radius></sphere></geometry>
<surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
</collision>
<visual name="caster_visual">
<pose>0.08 0 -0.045 0 0 0</pose>
<geometry><sphere><radius>0.015</radius></sphere></geometry>
</visual>
<visual name="lidar_visual">
<pose>0 0 0.045 0 0 0</pose>
<geometry><cylinder><radius>0.03</radius><length>0.03</length></cylinder></geometry>
<material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
</visual>
<sensor name="lidar" type="gpu_lidar">
<pose>0 0 0.05 0 0 0</pose>
<topic>/scan_raw</topic>
<ignition_frame_id>lidar_link</ignition_frame_id>
<update_rate>10</update_rate>
<always_on>true</always_on>
<ray>
<scan>
<horizontal>
<samples>360</samples>
<resolution>1</resolution>
<min_angle>-3.14159</min_angle>
<max_angle>3.14159</max_angle>
</horizontal>
<vertical>
<samples>1</samples>
<resolution>1</resolution>
<min_angle>0</min_angle>
<max_angle>0</max_angle>
</vertical>
</scan>
<range>
<min>0.05</min>
<max>8.0</max>
<resolution>0.01</resolution>
</range>
</ray>
</sensor>
</link>
 
      <link name="left_wheel">
<pose>-0.05 0.1 0.0325 -1.5707 0 0</pose>
<inertial>
<mass>0.1</mass>
<inertia>
<ixx>3.2e-5</ixx><iyy>3.2e-5</iyy><izz>5.3e-5</izz>
<ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
</inertia>
</inertial>
<collision name="collision">
<geometry><cylinder><radius>0.0325</radius><length>0.025</length></cylinder></geometry>
</collision>
<visual name="visual">
<geometry><cylinder><radius>0.0325</radius><length>0.025</length></cylinder></geometry>
<material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
</visual>
</link>
 
      <link name="right_wheel">
<pose>-0.05 -0.1 0.0325 -1.5707 0 0</pose>
<inertial>
<mass>0.1</mass>
<inertia>
<ixx>3.2e-5</ixx><iyy>3.2e-5</iyy><izz>5.3e-5</izz>
<ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
</inertia>
</inertial>
<collision name="collision">
<geometry><cylinder><radius>0.0325</radius><length>0.025</length></cylinder></geometry>
</collision>
<visual name="visual">
<geometry><cylinder><radius>0.0325</radius><length>0.025</length></cylinder></geometry>
<material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
</visual>
</link>
 
      <joint name="left_wheel_joint" type="revolute">
<parent>chassis</parent>
<child>left_wheel</child>
<axis><xyz>0 0 1</xyz></axis>
</joint>
<joint name="right_wheel_joint" type="revolute">
<parent>chassis</parent>
<child>right_wheel</child>
<axis><xyz>0 0 1</xyz></axis>
</joint>
 
      <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
<left_joint>left_wheel_joint</left_joint>
<right_joint>right_wheel_joint</right_joint>
<wheel_separation>0.2</wheel_separation>
<wheel_radius>0.0325</wheel_radius>
<topic>/cmd_vel</topic>
<odom_topic>/odom</odom_topic>
<tf_topic>/tf</tf_topic>
<frame_id>odom</frame_id>
<child_frame_id>base_link</child_frame_id>
<odom_publish_frequency>20</odom_publish_frequency>
</plugin>
</model>
 
  </world>
</sdf>
 