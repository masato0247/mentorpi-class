<?xml version="1.0"?>
<sdf version="1.8">
<world name="practice">
 
    <physics name="1ms" type="ignored">
<max_step_size>0.001</max_step_size>
<real_time_factor>1.0</real_time_factor>
</physics>
 
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
<plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
<plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
<plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
<render_engine>ogre2</render_engine>
</plugin>
 
    <light type="directional" name="sun">
<cast_shadows>true</cast_shadows>
<pose>0 0 10 0 0 0</pose>
<diffuse>0.8 0.8 0.8 1</diffuse>
<specular>0.2 0.2 0.2 1</specular>
<direction>-0.5 0.1 -0.9</direction>
</light>
 
    <!-- 床 -->
<model name="ground_plane">
<static>true</static>
<link name="link">
<collision name="collision">
<geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
</collision>
<visual name="visual">
<geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
<material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
</visual>
</link>
</model>
    <!-- 部屋の壁（内側 5m×5m、厚さ20cm、高さ50cm）と、壁から出っ張った柱 -->
<model name="walls">
<static>true</static>
<link name="north">
<pose>0 2.6 0.25 0 0 0</pose>
<collision name="c"><geometry><box><size>5.4 0.2 0.5</size></box></geometry></collision>
<visual name="v"><geometry><box><size>5.4 0.2 0.5</size></box></geometry></visual>
</link>
<link name="south">
<pose>0 -2.6 0.25 0 0 0</pose>
<collision name="c"><geometry><box><size>5.4 0.2 0.5</size></box></geometry></collision>
<visual name="v"><geometry><box><size>5.4 0.2 0.5</size></box></geometry></visual>
</link>
<link name="east">
<pose>2.6 0 0.25 0 0 0</pose>
<collision name="c"><geometry><box><size>0.2 5.4 0.5</size></box></geometry></collision>
<visual name="v"><geometry><box><size>0.2 5.4 0.5</size></box></geometry></visual>
</link>
<link name="west">
<pose>-2.6 0 0.25 0 0 0</pose>
<collision name="c"><geometry><box><size>0.2 5.4 0.5</size></box></geometry></collision>
<visual name="v"><geometry><box><size>0.2 5.4 0.5</size></box></geometry></visual>
</link>
<link name="pillar_north">
<pose>-0.8 2.4 0.25 0 0 0</pose>
<collision name="c"><geometry><box><size>0.4 0.2 0.5</size></box></geometry></collision>
<visual name="v"><geometry><box><size>0.4 0.2 0.5</size></box></geometry></visual>
</link>
<link name="pillar_east">
<pose>2.4 0.6 0.25 0 0 0</pose>
<collision name="c"><geometry><box><size>0.2 0.4 0.5</size></box></geometry></collision>
<visual name="v"><geometry><box><size>0.2 0.4 0.5</size></box></geometry></visual>
</link>
</model>
 
    <!-- 箱A（オレンジ、30cm角） -->
<model name="box_a">
<static>true</static>
<pose>-1.2 -1.2 0.2 0 0 0</pose>
<link name="link">
<collision name="c"><geometry><box><size>0.3 0.3 0.4</size></box></geometry></collision>
<visual name="v">
<geometry><box><size>0.3 0.3 0.4</size></box></geometry>
<material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material>
</visual>
</link>
</model>
 
    <!-- 箱B（緑、60cm×30cm） -->
<model name="box_b">
<static>true</static>
<pose>1.2 1.3 0.2 0 0 0</pose>
<link name="link">
<collision name="c"><geometry><box><size>0.6 0.3 0.4</size></box></geometry></collision>
<visual name="v">
<geometry><box><size>0.6 0.3 0.4</size></box></geometry>
<material><ambient>0.2 0.7 0.3 1</ambient><diffuse>0.2 0.7 0.3 1</diffuse></material>
</visual>
</link>
</model>
 
    <!-- 円柱（青、直径30cm） -->
<model name="cylinder_c">
<static>true</static>
<pose>1.3 -1.1 0.2 0 0 0</pose>
<link name="link">
<collision name="c"><geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry></collision>
<visual name="v">
<geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry>
<material><ambient>0.2 0.4 0.9 1</ambient><diffuse>0.2 0.4 0.9 1</diffuse></material>
</visual>
</link>
</model>
 
<!-- MentorPi（アッカーマン式・4輪）
         実機の寸法：全長20cm、全幅15cm、車体の高さ12cm、タイヤ直径6.5cm・幅2.5cm、
         左右の車輪の間隔12.5cm、前後の車輪の間隔14cm、LiDARは中心から後ろ2cm・床から14.5cm
         ロボットの中心（base_link）は、前後の車軸の真ん中・左右の真ん中・床の高さ -->
<model name="mentorpi">
<pose>0 0 0.005 0 0 0</pose>
 
      <!-- 車体 -->
<link name="chassis">
<inertial>
<pose>0 0 0.07 0 0 0</pose>
<mass>1.2</mass>
<inertia>
<ixx>0.00162</ixx><iyy>0.00337</iyy><izz>0.00337</izz>
<ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
</inertia>
</inertial>
<collision name="collision">
<pose>0 0 0.075 0 0 0</pose>
<geometry><box><size>0.16 0.09 0.09</size></box></geometry>
</collision>
<visual name="visual">
<pose>0 0 0.075 0 0 0</pose>
<geometry><box><size>0.16 0.09 0.09</size></box></geometry>
<material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
</visual>
<visual name="camera_visual">
<pose>0.09 0 0.105 0 0 0</pose>
<geometry><box><size>0.02 0.08 0.025</size></box></geometry>
<material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
</visual>
<visual name="lidar_visual">
<pose>-0.02 0 0.14 0 0 0</pose>
<geometry><cylinder><radius>0.03</radius><length>0.04</length></cylinder></geometry>
<material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
</visual>
<sensor name="lidar" type="gpu_lidar">
<pose>-0.02 0 0.145 0 0 0</pose>
<topic>/scan_raw</topic>
<ignition_frame_id>lidar_link</ignition_frame_id>
<update_rate>10</update_rate>
<always_on>true</always_on>
<ray>
<scan>
<horizontal>
<samples>{{LIDAR_SAMPLES}}</samples>
<resolution>1</resolution>
<min_angle>-3.14159</min_angle>
<max_angle>3.14159</max_angle>
</horizontal>
<vertical>
<samples>1</samples>
<resolution>1</resolution>
<min_angle>0</min_angle>
<max_angle>0</max_angle>
</vertical>
</scan>
<range>
<min>{{LIDAR_RANGE_MIN}}</min>
<max>{{LIDAR_RANGE_MAX}}</max>
<resolution>0.001</resolution>
</range>
<noise>
<type>gaussian</type>
<mean>0.0</mean>
<stddev>{{LIDAR_NOISE_STDDEV}}</stddev>
</noise>
</ray>
</sensor>
</link>
 
      <!-- 後輪（モーターで回す） -->
<link name="rear_left_wheel">
<pose>-0.07 0.0625 0.0325 -1.5707 0 0</pose>
<inertial>
<mass>0.05</mass>
<inertia>
<ixx>1.6e-5</ixx><iyy>1.6e-5</iyy><izz>2.6e-5</izz>
<ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
</inertia>
</inertial>
<collision name="collision">
<geometry><cylinder><radius>0.0325</radius><length>0.025</length></cylinder></geometry>
</collision>
<visual name="visual">
<geometry><cylinder><radius>0.0325</radius><length>0.025</length></cylinder></geometry>
<material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
</visual>
</link>
<link name="rear_right_wheel">
<pose>-0.07 -0.0625 0.0325 -1.5707 0 0</pose>
<inertial>
<mass>0.05</mass>
<inertia>
<ixx>1.6e-5</ixx><iyy>1.6e-5</iyy><izz>2.6e-5</izz>
<ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
</inertia>
</inertial>
<collision name="collision">
<geometry><cylinder><radius>0.0325</radius><length>0.025</length></cylinder></geometry>
</collision>
<visual name="visual">
<geometry><cylinder><radius>0.0325</radius><length>0.025</length></cylinder></geometry>
<material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
</visual>
</link>
 
      <!-- 前輪の向きを変える部品（ステアリング） -->
<link name="front_left_steering">
<pose>0.07 0.05 0.0325 0 0 0</pose>
<inertial>
<mass>0.02</mass>
<inertia>
<ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz>
<ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
</inertia>
</inertial>
</link>
<link name="front_right_steering">
<pose>0.07 -0.05 0.0325 0 0 0</pose>
<inertial>
<mass>0.02</mass>
<inertia>
<ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz>
<ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
</inertia>
</inertial>
</link>
 
      <!-- 前輪（向きが変わる。モーターでは回さない） -->
<link name="front_left_wheel">
<pose>0.07 0.0625 0.0325 -1.5707 0 0</pose>
<inertial>
<mass>0.05</mass>
<inertia>
<ixx>1.6e-5</ixx><iyy>1.6e-5</iyy><izz>2.6e-5</izz>
<ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
</inertia>
</inertial>
<collision name="collision">
<geometry><cylinder><radius>0.0325</radius><length>0.025</length></cylinder></geometry>
</collision>
<visual name="visual">
<geometry><cylinder><radius>0.0325</radius><length>0.025</length></cylinder></geometry>
<material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
</visual>
</link>
<link name="front_right_wheel">
<pose>0.07 -0.0625 0.0325 -1.5707 0 0</pose>
<inertial>
<mass>0.05</mass>
<inertia>
<ixx>1.6e-5</ixx><iyy>1.6e-5</iyy><izz>2.6e-5</izz>
<ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
</inertia>
</inertial>
<collision name="collision">
<geometry><cylinder><radius>0.0325</radius><length>0.025</length></cylinder></geometry>
</collision>
<visual name="visual">
<geometry><cylinder><radius>0.0325</radius><length>0.025</length></cylinder></geometry>
<material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
</visual>
</link>
 
      <!-- 関節 -->
<joint name="rear_left_wheel_joint" type="revolute">
<parent>chassis</parent>
<child>rear_left_wheel</child>
<axis><xyz>0 0 1</xyz></axis>
</joint>
<joint name="rear_right_wheel_joint" type="revolute">
<parent>chassis</parent>
<child>rear_right_wheel</child>
<axis><xyz>0 0 1</xyz></axis>
</joint>
<joint name="front_left_steering_joint" type="revolute">
<parent>chassis</parent>
<child>front_left_steering</child>
<axis>
<xyz>0 0 1</xyz>
<limit><lower>-0.6</lower><upper>0.6</upper><effort>1000000</effort></limit>
</axis>
</joint>
<joint name="front_right_steering_joint" type="revolute">
<parent>chassis</parent>
<child>front_right_steering</child>
<axis>
<xyz>0 0 1</xyz>
<limit><lower>-0.6</lower><upper>0.6</upper><effort>1000000</effort></limit>
</axis>
</joint>
<joint name="front_left_wheel_joint" type="revolute">
<parent>front_left_steering</parent>
<child>front_left_wheel</child>
<axis><xyz>0 0 1</xyz></axis>
</joint>
<joint name="front_right_wheel_joint" type="revolute">
<parent>front_right_steering</parent>
<child>front_right_wheel</child>
<axis><xyz>0 0 1</xyz></axis>
</joint>
 
      <!-- 速度指令(/cmd_vel)を、後輪の回転と前輪の向きに変える -->
<plugin filename="ignition-gazebo-ackermann-steering-system" name="ignition::gazebo::systems::AckermannSteering">
<left_joint>rear_left_wheel_joint</left_joint>
<right_joint>rear_right_wheel_joint</right_joint>
<left_steering_joint>front_left_steering_joint</left_steering_joint>
<right_steering_joint>front_right_steering_joint</right_steering_joint>
<kingpin_width>0.10</kingpin_width>
<steering_limit>0.5</steering_limit>
<wheel_base>0.14</wheel_base>
<wheel_separation>0.125</wheel_separation>
<wheel_radius>0.0325</wheel_radius>
<min_velocity>-0.5</min_velocity>
<max_velocity>0.5</max_velocity>
<min_acceleration>-1.0</min_acceleration>
<max_acceleration>1.0</max_acceleration>
<topic>/cmd_vel</topic>
<odom_topic>/odom</odom_topic>
<tf_topic>/tf</tf_topic>
<frame_id>odom</frame_id>
<child_frame_id>base_link</child_frame_id>
<odom_publish_frequency>20</odom_publish_frequency>
</plugin>
</model>
 
  </world>
</sdf>
 